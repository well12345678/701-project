<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>701 PROJECT — стант на мотоциклах</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0a0c;
    --panel: #121216;
    --text: #ffffff;
    --muted: #8d8d97;
    --accent: #7c5cff;
    --accent-2: #a890ff;
    --line: rgba(255, 255, 255, 0.08);
    color-scheme: dark;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) { color-scheme: dark; }
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    line-height: 1.55;
    overflow-x: hidden;
  }
  a { color: inherit; }

  /* ---------- top bar ---------- */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 20;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 16px 24px;
    background: rgba(10, 10, 12, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    animation: slideDown 0.7s ease both;
  }
  .logo { font-weight: 900; letter-spacing: 0.12em; font-size: 0.95rem; text-transform: uppercase; text-decoration: none; }
  .logo span { color: var(--accent); }
  nav ul { list-style: none; display: flex; gap: 22px; flex-wrap: wrap; }
  nav ul a {
    position: relative;
    text-decoration: none;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: color 0.2s;
  }
  nav ul a::after {
    content: "";
    position: absolute; left: 0; bottom: -6px;
    width: 0; height: 2px;
    background: var(--accent);
    transition: width 0.25s ease;
  }
  nav ul a:hover { color: var(--text); }
  nav ul a:hover::after { width: 100%; }

  /* ---------- hero ---------- */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 104px 24px 88px;
    overflow: hidden;
  }
  .hero::before {
    /* slowly breathing purple light behind the title */
    content: "";
    position: absolute; inset: -10%;
    background:
      radial-gradient(ellipse 60% 45% at 50% 42%, rgba(124, 92, 255, 0.22), transparent 70%),
      radial-gradient(ellipse 40% 30% at 20% 80%, rgba(124, 92, 255, 0.08), transparent 70%);
    animation: breathe 9s ease-in-out infinite;
    pointer-events: none;
  }
  .hero::after {
    /* vignette, like the photo-darkened backdrop in the reference */
    content: "";
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at center, transparent 30%, var(--bg) 95%);
    pointer-events: none;
  }
  .hero > * { position: relative; z-index: 1; }

  .eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--muted);
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
    padding: 8px 16px;
    border-radius: 999px;
    animation: fadeUp 0.9s 0.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .eyebrow .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent);
    animation: ping 2s ease-out infinite;
  }

  h1 {
    margin: 28px 0 20px;
    font-size: clamp(2.2rem, 6vw, 4.4rem);
    line-height: 1;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    text-shadow: 0 0 40px rgba(255, 255, 255, 0.25);
    animation:
      fadeUp 1s 0.25s cubic-bezier(0.2, 0.7, 0.2, 1) both,
      glow 4s 1.2s ease-in-out infinite;
  }
  h1 .accent { color: var(--accent); text-shadow: 0 0 40px rgba(124, 92, 255, 0.55); }

  .lead {
    max-width: 560px;
    color: var(--muted);
    font-size: clamp(1rem, 2.2vw, 1.15rem);
    animation: fadeUp 1s 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .actions {
    display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;
    margin-top: 36px;
    animation: fadeUp 1s 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 14px 26px;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.92rem;
    transition: transform 0.2s ease, background 0.25s, box-shadow 0.25s, border-color 0.25s, color 0.25s;
  }
  .btn:hover { transform: translateY(-2px); }
  .btn-primary { background: #fff; color: #000; }
  .btn-primary:hover { background: var(--accent); color: #fff; box-shadow: 0 10px 30px rgba(124, 92, 255, 0.4); }
  .btn-ghost { border: 1px solid rgba(255, 255, 255, 0.18); color: var(--text); background: rgba(255, 255, 255, 0.02); }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent-2); }

  .stats {
    display: flex; gap: 56px; flex-wrap: wrap; justify-content: center;
    margin-top: 56px;
    animation: fadeUp 1s 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .stat { text-align: center; }
  .stat b {
    display: block;
    font-size: clamp(2rem, 5vw, 2.6rem);
    font-weight: 900;
    line-height: 1.1;
    color: var(--accent);
    text-shadow: 0 0 24px rgba(124, 92, 255, 0.35);
  }
  .stat small {
    display: block;
    margin-top: 6px;
    font-size: 0.68rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .scroll-hint {
    position: absolute; bottom: 28px; left: 50%;
    transform: translateX(-50%);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    display: flex; flex-direction: column; align-items: center; gap: 10px;
    animation: fadeIn 1s 1.2s both;
  }
  .scroll-hint i {
    width: 1px; height: 36px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    animation: drop 1.8s ease-in-out infinite;
  }

  /* ---------- sections ---------- */
  section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 120px 24px 0;
  }
  .head { margin-bottom: 40px; text-align: center; }
  .kicker {
    display: inline-block;
    font-size: 0.7rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.22em;
    color: var(--accent-2);
    margin-bottom: 12px;
  }
  h2 {
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1.05;
  }
  .head p { color: var(--muted); margin-top: 12px; }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .card {
    position: relative;
    display: block;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 30px;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .card::before {
    /* purple light that follows the top edge on hover */
    content: "";
    position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: rgba(124, 92, 255, 0.5);
    box-shadow: 0 16px 40px rgba(124, 92, 255, 0.12);
  }
  .card:hover::before { opacity: 1; }
  .card .tag { color: var(--accent-2); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; }
  .card h3 { font-size: 1.35rem; font-weight: 800; margin: 12px 0 8px; }
  .card p { color: var(--muted); font-size: 0.95rem; }
  .card .arrow {
    display: inline-block; margin-top: 18px;
    color: var(--text); font-weight: 700; font-size: 0.85rem;
    transition: transform 0.3s, color 0.3s;
  }
  .card:hover .arrow { transform: translateX(6px); color: var(--accent-2); }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .step {
    position: relative;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 30px;
  }
  .step .num {
    font-size: 3rem; font-weight: 900; line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--accent);
  }
  a.step {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  a.step:hover {
    transform: translateY(-4px);
    border-color: rgba(124, 92, 255, 0.5);
    box-shadow: 0 16px 40px rgba(124, 92, 255, 0.12);
  }
  a.step .arrow {
    display: inline-block; margin-top: 18px;
    color: var(--text); font-weight: 700; font-size: 0.85rem;
    transition: transform 0.3s, color 0.3s;
  }
  a.step:hover .arrow { transform: translateX(6px); color: var(--accent-2); }
  .step h3 { margin: 18px 0 8px; font-size: 1.15rem; font-weight: 800; }
  .step p { color: var(--muted); font-size: 0.95rem; }

  .cta {
    position: relative;
    margin: 120px auto 0;
    padding: 64px 32px;
    border-radius: 24px;
    text-align: center;
    background: radial-gradient(ellipse at top, rgba(124, 92, 255, 0.22), var(--panel) 65%);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .cta h2 { max-width: 640px; margin: 0 auto 12px; }
  .cta p { color: var(--muted); margin-bottom: 32px; }
  .cta .actions { margin-top: 0; animation: none; }

  footer {
    margin-top: 96px;
    padding: 32px 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
  }

  /* ---------- discord modal ---------- */
  .modal {
    position: fixed; inset: 0; z-index: 50;
    display: flex; align-items: center; justify-content: center;
    padding: 16px;
    background: rgba(5, 5, 8, 0.7);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0; pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .modal.open { opacity: 1; pointer-events: auto; }
  .modal-box {
    position: relative;
    width: 100%; max-width: 380px;
    background: var(--panel);
    border: 1px solid rgba(124, 92, 255, 0.35);
    border-radius: 18px;
    padding: 32px 28px 28px;
    text-align: center;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(124, 92, 255, 0.15);
    transform: translateY(12px) scale(0.98);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .modal.open .modal-box { transform: none; }
  .modal-close {
    position: absolute; top: 12px; right: 14px;
    background: none; border: 0; color: var(--muted);
    font-size: 1.5rem; line-height: 1; cursor: pointer;
  }
  .modal-close:hover { color: var(--text); }
  .modal-box .tag { color: var(--accent-2); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; }
  .modal-box h3 { font-size: 1.4rem; font-weight: 900; text-transform: uppercase; margin: 10px 0 6px; }
  .modal-box p { color: var(--muted); font-size: 0.9rem; }
  .nick {
    margin: 22px 0 18px;
    padding: 16px;
    border-radius: 12px;
    background: rgba(124, 92, 255, 0.08);
    border: 1px solid rgba(124, 92, 255, 0.3);
    font-size: 1.25rem; font-weight: 800;
    word-break: break-all;
    color: var(--text);
  }
  .copy-btn {
    width: 100%;
    padding: 13px;
    border: 0; border-radius: 10px;
    background: #fff; color: #000;
    font: inherit; font-weight: 700; font-size: 0.92rem;
    cursor: pointer;
    transition: background 0.25s, color 0.25s;
  }
  .copy-btn:hover { background: var(--accent); color: #fff; }
  .copy-note { min-height: 1.2em; margin-top: 10px; font-size: 0.82rem; color: var(--accent-2); }

  /* ---------- reveal on scroll ---------- */
  .js .reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .js .reveal.in { opacity: 1; transform: none; }

  /* ---------- keyframes ---------- */
  @keyframes fadeUp   { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  @keyframes fadeIn   { from { opacity: 0; } to { opacity: 1; } }
  @keyframes slideDown { from { opacity: 0; transform: translateY(-100%); } to { opacity: 1; transform: none; } }
  @keyframes breathe  { 0%, 100% { opacity: 0.8; transform: scale(1); } 50% { opacity: 1; transform: scale(1.06); } }
  @keyframes glow {
    0%, 100% { text-shadow: 0 0 30px rgba(255, 255, 255, 0.2); }
    50%      { text-shadow: 0 0 60px rgba(255, 255, 255, 0.42); }
  }
  @keyframes ping {
    0%   { box-shadow: 0 0 0 0 rgba(124, 92, 255, 0.7); }
    70%  { box-shadow: 0 0 0 9px rgba(124, 92, 255, 0); }
    100% { box-shadow: 0 0 0 0 rgba(124, 92, 255, 0); }
  }
  @keyframes drop {
    0%   { transform: scaleY(0); transform-origin: top; }
    50%  { transform: scaleY(1); transform-origin: top; }
    51%  { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  /* ---------- responsive ---------- */
  @media (max-width: 720px) {
    nav { padding: 14px 16px; flex-direction: column; gap: 12px; }
    nav ul { justify-content: center; gap: 16px; }
    .hero { padding: 150px 16px 110px; }
    .stats { gap: 36px; margin-top: 56px; }
    section { padding: 88px 16px 0; }
    .cta { padding: 48px 20px; margin-top: 88px; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
    .js .reveal { opacity: 1; transform: none; }
  }
</style>
</head>
