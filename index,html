    <div class="copy-note" id="copy-note"></div>
  </div>
</div>

<script>
  (function () {
    var modal = document.getElementById('discord-modal');
    var copyBtn = document.getElementById('copy-nick');
    var note = document.getElementById('copy-note');
    var nick = document.getElementById('discord-nick').textContent.trim();

    function open() {
      note.textContent = '';
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      var close = modal.querySelector('[data-close]');
      if (close) close.focus();
    }
    function close() {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
    }

    document.querySelectorAll('[data-open-discord]').forEach(function (el) {
      el.addEventListener('click', function (e) { e.preventDefault(); open(); });
    });
    modal.addEventListener('click', function (e) {
      if (e.target === modal || e.target.hasAttribute('data-close')) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal.classList.contains('open')) close();
    });
    copyBtn.addEventListener('click', function () {
      function done(ok) { note.textContent = ok ? 'Ник скопирован' : 'Не удалось скопировать, выдели ник вручную'; }
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(nick).then(function () { done(true); }, function () { done(false); });
        } else {
          done(false);
        }
      } catch (err) {
        done(false);
      }
    });
  })();
</script>

